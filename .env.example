# Postgres
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=jobagent
POSTGRES_DB=jobagent
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
APP_NAME=JobAgent
APP_ENV=development
DEBUG=true

# Used by local (non-Docker) runs; Compose overrides hostnames to service names
DATABASE_URL=postgresql+psycopg://jobagent:jobagent@localhost:5432/jobagent
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Auth — MUST change JWT_SECRET_KEY before any public deploy
JWT_SECRET_KEY=change-me-in-production-jobagent-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Google AI Studio (Gemini) — required for resume parsing / scoring / tailor
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Web dashboard (local)
WEB_PORT=5173
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_PUBLIC_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Production / public beta (docker-compose.prod.yml) — see docs/deploy.md
# ---------------------------------------------------------------------------
# DOMAIN=jobagent.yourdomain.com
# APP_ENV=production
# DEBUG=false
# POSTGRES_PASSWORD=<strong-random-password>
# JWT_SECRET_KEY=<strong-random-secret>
# VITE_API_URL=/api
# CORS_ORIGINS=https://jobagent.yourdomain.com
# APP_PUBLIC_URL=https://jobagent.yourdomain.com
# HTTP_PORT=80
# HTTPS_PORT=443

# Job scanner (Celery beat every 2 hours)
SCANNER_ENABLED=true
SCANNER_KEYWORDS=python developer
SCANNER_LOCATIONS=bangalore
SCANNER_PORTALS=naukri,linkedin,internshala,foundit,unstop
SCANNER_MAX_PAGES=1
SCANNER_HEADLESS=true
# Leave empty in Docker (uses Chromium). On desktop you can set: chrome
SCANNER_BROWSER_CHANNEL=

# Phase 4 Stage 1 — vector matching
MATCH_VECTOR_LIMIT=50
MATCH_MIN_SIMILARITY=0.35
EMBED_JOBS_BATCH_SIZE=40

# Phase 4 Stage 2 — Gemini deep-score
MATCH_DEEP_SCORE_LIMIT=10

# Notifications — Email + WhatsApp (Twilio)
# On Railway/cloud hosts, Gmail SMTP is often blocked. Prefer Resend (HTTPS):
#   RESEND_API_KEY=re_xxx
#   SMTP_FROM_EMAIL=onboarding@resend.dev   # or your verified domain sender
# Leave blank in local/dev: channels are skipped, in-app notifications still created.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=JobAgent
SMTP_USE_TLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Example Twilio sandbox: whatsapp:+14155238886
